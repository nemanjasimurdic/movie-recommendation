FUNCTION_BLOCK film_quality

VAR_INPUT
    DirectorRating : REAL;
    ActorsRating : REAL;
    StoryRating : REAL;
    VisualRating : REAL;
    CultureRating : REAL;
END_VAR

VAR_OUTPUT
    FilmQuality : REAL;
END_VAR

// Fuzzify input variables
FUZZIFY DirectorRating
    TERM poor := (0, 1) (3, 0);
    TERM good := (2, 0) (5, 1) (8, 0);
    TERM excellent := (6, 0) (10, 1);
END_FUZZIFY

FUZZIFY ActorsRating
    TERM weak := (0, 1) (3, 0);
    TERM decent := (2, 0) (5, 1) (8, 0);
    TERM strong := (6, 0) (10, 1);
END_FUZZIFY

FUZZIFY StoryRating
    TERM boring := (0, 1) (3, 0);
    TERM interesting := (2, 0) (5, 1) (8, 0);
    TERM brilliant := (6, 0) (10, 1);
END_FUZZIFY

FUZZIFY VisualRating
    TERM poor := (0, 1) (3, 0);
    TERM average := (2, 0) (5, 1) (8, 0);
    TERM stunning := (6, 0) (10, 1);
END_FUZZIFY

FUZZIFY CultureRating
    TERM low := (0, 1) (3, 0);
    TERM moderate := (2, 0) (5, 1) (8, 0);
    TERM high := (6, 0) (10, 1);
END_FUZZIFY

// Defuzzify output
DEFUZZIFY FilmQuality
    TERM bad := (0, 0) (30, 1) (50, 0);
    TERM good := (40, 0) (60, 1) (80, 0);
    TERM excellent := (70, 0) (100, 1);
    METHOD : COG;
    DEFAULT := 0;
END_DEFUZZIFY

// Rules
RULEBLOCK MovieRules
    AND : MIN;
    ACT : MIN;
    ACCU : MAX;

    RULE 1 : IF DirectorRating IS poor OR StoryRating IS boring THEN FilmQuality IS bad;
    RULE 2 : IF DirectorRating IS good AND StoryRating IS interesting THEN FilmQuality IS good;
    RULE 3 : IF DirectorRating IS excellent AND StoryRating IS brilliant THEN FilmQuality IS excellent;
    RULE 4 : IF ActorsRating IS weak THEN FilmQuality IS bad;
    RULE 5 : IF ActorsRating IS strong AND StoryRating IS interesting THEN FilmQuality IS good;
    RULE 6 : IF VisualRating IS poor THEN FilmQuality IS bad;
    RULE 7 : IF VisualRating IS stunning THEN FilmQuality IS excellent;
    RULE 8 : IF CultureRating IS high AND StoryRating IS brilliant THEN FilmQuality IS excellent;
    RULE 9 : IF CultureRating IS low AND DirectorRating IS poor THEN FilmQuality IS bad;
    RULE 10 : IF DirectorRating IS good AND ActorsRating IS decent AND VisualRating IS average THEN FilmQuality IS good;

END_RULEBLOCK

END_FUNCTION_BLOCK